# 可重复构建产物
dist/

# 浏览器与自动化临时产物
.playwright-cli/
output/

# 训练数据、实验检查点和历史评测档案（由完整项目备份单独保存）
experiments/
data/
models/
results/
vendor/
*.pt
*.npz
*.pyc
__pycache__/

# 研发工具（发布所需构建与核验工具除外）
tools/*
!tools/build_release.js
!tools/verify_release.js
!tools/test_release_worker_deadline.js

# 策略候选和中间导出，不是网页运行时
js/ai-policy-v*.js
js/*candidate*.js

# 研究历史（发布和源码维护由精简README覆盖）
PRO_LEVEL_TRAINING.md
TRAINING_PLAN.md
